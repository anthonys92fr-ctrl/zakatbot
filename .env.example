# ---- Modèle de langage (toute API compatible OpenAI) ----
# Aucun fournisseur n'est préconfiguré : renseigne ces trois valeurs ici OU dans l'admin (Réglages → Modèle de langage).
# Exemples d'URL de base : https://api.openai.com/v1 · https://api.groq.com/openai/v1 · https://api.mistral.ai/v1
#                          https://openrouter.ai/api/v1 · https://api.reflection.ai/openai/v1 · http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Raisonnement natif (reasoning_effort / reasoning_content) : on uniquement si le fournisseur le gère
LLM_REASONING=off
# Autoriser un fournisseur sur une adresse locale ou privée (Ollama sur localhost:11434) : 1. Sinon ces adresses sont refusées (anti-SSRF).
ALLOW_PRIVATE_LLM=

# Effort de raisonnement (si LLM_REASONING=on) : low | medium | high | xhigh | max
# "low" = réponses rapides. Les efforts élevés peuvent prendre plusieurs minutes.
REASONING_EFFORT=low

# Longueur max de la réponse (tokens)
MAX_TOKENS=2048

# Nombre de messages d'historique envoyés au modèle (user + assistant)
HISTORY_LIMIT=20

# Port d'écoute
PORT=3000
# Derrière un reverse proxy (Caddy, Nginx) : TRUST_PROXY=1 pour que les limites de débit voient la vraie adresse client
TRUST_PROXY=

# Mot de passe d'accès (optionnel). Vide = accès libre.
ACCESS_PASSWORD=

# Prompt système : personnalité et consignes du bot
SYSTEM_PROMPT=Tu es ZakatBot, un assistant pédagogique spécialisé sur la zakat (zakat al-maal et zakat al-fitr) : définition, conditions (nisab, hawl), biens concernés, méthodes de calcul, bénéficiaires, différences entre écoles juridiques, et pratique en France. Tu réponds dans la langue de l'utilisateur, de façon claire et structurée, en précisant quand les avis des savants divergent. Tu rappelles que tu donnes une information générale et qu'une situation personnelle complexe mérite l'avis d'un savant ou d'un organisme de collecte reconnu.

# ---- RAG ----
# Nombre de passages récupérés par question
TOP_K=5
# Embeddings locaux (on/off). "off" = BM25 seul, plus léger pour une petite VM.
EMBEDDINGS=on
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Effort de raisonnement pour l'extraction du graphe et pour le juge
GRAPH_EFFORT=low
JUDGE_EFFORT=medium
# Juge LLM activé (on/off). Modifiable à chaud depuis l'admin.
JUDGE_ENABLED=on
# Moteurs affichés par défaut : llm, rag, graph (séparés par des virgules). Modifiable à chaud depuis l'admin.
DEFAULT_MODES=llm,rag,graph

# ---- Admin (/admin) ----
# Mot de passe de la page d'administration. Vide = admin accessible uniquement depuis la machine locale (localhost).
ADMIN_PASSWORD=
