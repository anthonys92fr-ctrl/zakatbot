{
  "name": "zakatbot",
  "version": "1.0.0",
  "description": "ZakatBot : chatbot pédagogique sur la zakat comparant LLM seul, RAG et Graph RAG, avec juge LLM et administration (toute API compatible OpenAI)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "index": "node scripts/build-index.js",
    "fetch-pdfs": "bash deploy/fetch-pdfs.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "ipaddr.js": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "undici": "^8.12.3"
  },
  "license": "MIT"
}
